<script>
/* ============================================================
   CORE — utilities, session, cart engine, email outbox, router
   ============================================================ */

/* ---------- utils ---------- */
function esc(s){ return String(s==null?'':s).replace(/[&<>"']/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
function fmt(n){ return VERVE_CONFIG.currency + Math.round(n).toLocaleString(VERVE_CONFIG.locale); }
function uid(p){ return (p||'id')+'-'+Date.now().toString(36)+Math.random().toString(36).slice(2,7); }
async function sha256(str){
  if (!crypto || !crypto.subtle) { // non-secure context fallback (file:// may block subtle)
    let h=0; for (let i=0;i<str.length;i++){ h=(h<<5)-h+str.charCodeAt(i)|0; } return 'fb'+Math.abs(h).toString(16);
  }
  const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(str));
  return Array.from(new Uint8Array(buf)).map(b=>b.toString(16).padStart(2,'0')).join('');
}
function validEmail(e){ return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(String(e).trim()); }
function validPin(p){ return /^[1-9][0-9]{5}$/.test(String(p).trim()); }
function validPhone(p){ return /^[6-9][0-9]{9}$/.test(String(p).trim()); }
function debounce(fn,ms){ let t; return (...a)=>{ clearTimeout(t); t=setTimeout(()=>fn(...a),ms); }; }
function timeAgo(iso){
  const s=(Date.now()-new Date(iso).getTime())/1000;
  if (s<3600) return Math.max(1,Math.floor(s/60))+'m ago';
  if (s<86400) return Math.floor(s/3600)+'h ago';
  return Math.floor(s/86400)+'d ago';
}
function dFmt(iso){ return new Date(iso).toLocaleDateString(VERVE_CONFIG.locale,{day:'2-digit',month:'short',year:'numeric'}); }
function dTime(iso){ return new Date(iso).toLocaleString(VERVE_CONFIG.locale,{day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'}); }
function imgTag(src,alt,cls){ return '<img src="'+esc(src)+'" alt="'+esc(alt||'')+'" class="'+(cls||'')+'" loading="lazy" onerror="imgFallback(this)">'; }
function imgFallback(el){ const d=document.createElement('div'); d.style.cssText='width:100%;height:100%;background:linear-gradient(160deg,#2E1B14,#171513);display:flex;align-items:center;justify-content:center'; d.innerHTML='<span style="font-family:var(--serif);letter-spacing:.3em;color:#D6BD96;font-size:12px">THE&nbsp;VERVE</span>'; el.replaceWith(d); }
function svgIc(name){
  const p = {
    bag:'<path d="M6 7h12l1 13H5L6 7z"/><path d="M9 7a3 3 0 0 1 6 0"/>',
    heart:'<path d="M12 20s-7-4.6-9.2-8.7C1.2 8 3 5 6 5c1.9 0 3.2 1 4 2.3C10.8 6 12.1 5 14 5c3 0 4.8 3 3.2 6.3C19 15.4 12 20 12 20z"/>',
    search:'<circle cx="11" cy="11" r="7"/><path d="M21 21l-4.8-4.8"/>',
    user:'<circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 5-5.5 8-5.5s6.5 1.5 8 5.5"/>',
    close:'<path d="M5 5l14 14M19 5L5 19"/>',
    plus:'<path d="M12 5v14M5 12h14"/>',
    minus:'<path d="M5 12h14"/>',
    arrow:'<path d="M4 12h15M13 5l7 7-7 7"/>',
    menu:'<path d="M4 7h16M4 12h16M4 17h16"/>',
    check:'<path d="M4 12.5l5 5L20 6.5"/>',
    zoom:'<circle cx="11" cy="11" r="7"/><path d="M21 21l-4.8-4.8M8 11h6M11 8v6"/>',
    insta:'<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r=".9" fill="currentColor"/>',
    fb:'<path d="M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v6h4v-6h3l1-4h-4V8.5c0-.3.2-.5.5-.5z"/>',
    xx:'<path d="M4 4l7.5 9.5L4.5 20H7l5.6-5.9L17 20h3l-7.8-9.9L19.5 4H17l-5.2 5.5L8 4H4z"/>',
    yt:'<rect x="3" y="6" width="18" height="12" rx="3"/><path d="M10.5 9.5l5 2.5-5 2.5z"/>',
    box:'<path d="M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3z"/><path d="M12 12l8-4.5M12 12v9M12 12L4 7.5"/>',
    truck:'<path d="M2 7h11v9H2zM13 10h4l3 3v3h-7z"/><circle cx="6" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/>',
    shield:'<path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6l7-3z"/>',
    return:'<path d="M4 9h11a5 5 0 0 1 0 10H9"/><path d="M4 9l4-4M4 9l4 4"/>',
    spark:'<path d="M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5L18 18M18 6l-2.5 2.5M8.5 15.5L6 18"/>'
  };
  return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">'+(p[name]||'')+'</svg>';
}

/* ---------- toasts / modal ---------- */
function toast(msg, isErr){
  const w = document.getElementById('toasts');
  const t = document.createElement('div');
  t.className = 'toast'+(isErr?' err':'');
  t.textContent = msg;
  w.appendChild(t);
  setTimeout(()=>{ t.style.opacity='0'; t.style.transition='opacity .4s'; setTimeout(()=>t.remove(),400); }, 2600);
}
function openModal(html, wide){
  const w = document.getElementById('modal'), b = document.getElementById('modal-box');
  b.className = 'modal'+(wide?' wide':'')+(html.indexOf('pay-modal')>-1?' pay-modal':'');
  b.innerHTML = html;
  w.classList.add('on');
  document.body.style.overflow='hidden';
  w.querySelectorAll('[data-close-modal]').forEach(el=>el.addEventListener('click', closeModal));
}
function closeModal(){
  document.getElementById('modal').classList.remove('on');
  document.body.style.overflow='';
}
document.addEventListener('keydown', e=>{ if(e.key==='Escape'){ closeModal(); closeDrawer('cdrawer'); closeDrawer('mnav'); }});

/* ---------- drawers ---------- */
function openDrawer(id){ document.getElementById(id).classList.add('on'); document.getElementById('scrim').classList.add('on'); document.body.style.overflow='hidden'; }
function closeDrawer(id){ document.getElementById(id).classList.remove('on'); const s=document.getElementById('scrim'); if(!document.querySelector('.drawer.on')){ s.classList.remove('on'); document.body.style.overflow=''; } }
document.getElementById('scrim').addEventListener('click', ()=>{ closeDrawer('cdrawer'); closeDrawer('mnav'); });

/* ---------- session ---------- */
function currentUser(){ const t = localStorage.getItem(VERVE_CONFIG.tokenKey); if(!t||!DB.sessions[t]) return null; return DB.users.find(u=>u.id===DB.sessions[t])||null; }
function loginSession(user){ const t=uid('tok'); DB.sessions[t]=user.id; localStorage.setItem(VERVE_CONFIG.tokenKey, t); saveDB(); }
function logoutSession(){ const t=localStorage.getItem(VERVE_CONFIG.tokenKey); if(t){ delete DB.sessions[t]; saveDB(); } localStorage.removeItem(VERVE_CONFIG.tokenKey); }
function isAdmin(){ const u=currentUser(); return !!(u && u.role==='admin'); }

/* ---------- cart engine ---------- */
function cartId(){ const u=currentUser(); if(u) return u.id; let g=localStorage.getItem(VERVE_CONFIG.guestKey); if(!g){ g=uid('guest'); localStorage.setItem(VERVE_CONFIG.guestKey,g); } return g; }
function cartItems(){ const c=DB.carts[cartId()]; return (c&&c.items)||[]; }
function cartCount(){ return cartItems().reduce((n,i)=>n+i.qty,0); }
function stockOf(pid,color,size){ const v=DB.inventory[invKey(pid,color,size)]; return v==null?0:v; }
function setStock(pid,color,size,q){ DB.inventory[invKey(pid,color,size)]=Math.max(0,q); }
function addToCart(pid,color,size,qty){
  const p = DB.products.find(x=>x.id===pid);
  if(!p || !p.published) return { ok:false, msg:'Product unavailable' };
  const avail = stockOf(pid,color,size);
  if (avail<=0) return { ok:false, msg:'Selected size is sold out' };
  const items = cartItems();
  const ex = items.find(i=>i.pid===pid&&i.color===color&&i.size===size);
  const want = (ex?ex.qty:0)+qty;
  if (want>avail) return { ok:false, msg:'Only '+avail+' left in this size' };
  if (ex) ex.qty=want; else items.push({ pid, color, size, qty });
  DB.carts[cartId()] = { items, updatedAt:new Date().toISOString(), email:(currentUser()||{}).email||null };
  saveDB();
  return { ok:true, msg:'Added to bag' };
}
function updateCartItem(idx, qty){
  const items = cartItems();
  if(!items[idx]) return;
  if (qty<=0){ items.splice(idx,1); }
  else {
    const avail = stockOf(items[idx].pid, items[idx].color, items[idx].size);
    items[idx].qty = Math.min(qty, Math.max(avail,1));
  }
  DB.carts[cartId()] = { items, updatedAt:new Date().toISOString(), email:(currentUser()||{}).email||null };
  saveDB();
}
function mergeGuestCart(){
  const g = localStorage.getItem(VERVE_CONFIG.guestKey); if(!g) return;
  const gc = DB.carts[g]; const u = currentUser(); if(!gc||!u) return;
  const uc = DB.carts[u.id] || { items:[] };
  gc.items.forEach(gi=>{
    const ex = uc.items.find(i=>i.pid===gi.pid&&i.color===gi.color&&i.size===gi.size);
    const avail = stockOf(gi.pid,gi.color,gi.size);
    if (ex) ex.qty = Math.min(ex.qty+gi.qty, Math.max(avail,1));
    else uc.items.push({...gi, qty:Math.min(gi.qty, Math.max(avail,1))});
  });
  uc.updatedAt = new Date().toISOString(); uc.email = u.email;
  DB.carts[u.id] = uc; delete DB.carts[g];
  localStorage.removeItem(VERVE_CONFIG.guestKey);
  saveDB();
}

/* ---------- pricing: tax (GST inclusive), shipping, coupons ---------- */
function lineTaxIncluded(price){
  const rate = price <= 1000 ? 0.05 : 0.12;   // Indian apparel GST slab (demo)
  const gross = price;
  const net = Math.round(gross / (1+rate));
  return { rate, included: gross-net };
}
function cartCalc(couponCode){
  const items = cartItems().map(i=>{
    const p = DB.products.find(x=>x.id===i.pid);
    const price = p? p.price : 0;
    const line = price*i.qty;
    return { ...i, name:p?p.name:'Item', slug:p?p.slug:'', image:p?p.images[0]:'', price, line,
             tax: lineTaxIncluded(price).included * i.qty };
  });
  const subtotal = items.reduce((s,i)=>s+i.line,0);
  const taxIncl = items.reduce((s,i)=>s+i.tax,0);
  const sh = DB.settings.shipping;
  let discount = 0, coupon = null, freeShip = false, shipMsg = '';
  if (couponCode){
    const c = DB.coupons.find(x=>x.code.toUpperCase()===couponCode.toUpperCase());
    if (c && c.active){
      if (subtotal < c.min) shipMsg = 'Add '+fmt(c.min-subtotal)+' more to use '+c.code;
      else if (c.usageLimit && c.used >= c.usageLimit) shipMsg = c.code+' usage limit reached';
      else {
        coupon = c.code;
        if (c.type==='percent') discount = Math.round(subtotal*c.value/100);
        else if (c.type==='flat') discount = Math.min(c.value, subtotal);
        else if (c.type==='freeship') freeShip = true;
      }
    } else shipMsg = couponCode ? 'Coupon is invalid or inactive' : '';
  }
  let shipping = (subtotal===0 || subtotal>=sh.freeAbove || freeShip) ? 0 : sh.flat;
  return { items, subtotal, discount, coupon, shipping, taxIncl, total: Math.max(0, subtotal - discount + shipping), shipMsg, freeAbove: sh.freeAbove };
}
function validateCoupon(code){
  const c = DB.coupons.find(x=>x.code.toUpperCase()===String(code).toUpperCase());
  const sub = cartCalc().subtotal;
  if (!c) return { ok:false, msg:'Invalid coupon code' };
  if (!c.active) return { ok:false, msg:'This coupon is no longer active' };
  if (c.usageLimit && c.used>=c.usageLimit) return { ok:false, msg:'Coupon usage limit reached' };
  if (sub < c.min) return { ok:false, msg:'Minimum order '+fmt(c.min)+' required for '+c.code };
  return { ok:true, coupon:c, msg:c.code+' applied — '+(c.type==='percent'? c.value+'% off' : c.type==='flat'? fmt(c.value)+' off' : 'free shipping') };
}

/* ---------- email outbox (simulated — Resend in production) ---------- */
function sendEmail(kind, to, vars){
  const templates = {
    orderConfirmation: o => ({ subject:'THE VERVE — Order '+o.no+' confirmed', html:
      '<div style="background:#F5F0E7;padding:28px;font-family:Georgia,serif;color:#24140F">'+
      '<div style="letter-spacing:.35em;font-size:20px;text-align:center;margin-bottom:6px">THE VERVE</div>'+
      '<div style="letter-spacing:.4em;font-size:9px;text-align:center;color:#651B2B;margin-bottom:22px">DEFINE YOUR PRESENCE.</div>'+
      '<h2 style="font-weight:500">Thank you, '+esc(o.name)+'</h2>'+
      '<p style="font-size:14px">Order <b>'+o.no+'</b> is confirmed'+(o.payment.method==='razorpay'?' and payment was received':' (Cash on Delivery)')+'. We are preparing it with care.</p>'+
      '<table style="width:100%;border-collapse:collapse;font-size:13px;margin:14px 0">'+
      o.items.map(i=>'<tr><td style="padding:6px 0;border-bottom:1px solid #E4DAC8">'+esc(i.name)+' — '+esc(i.color)+' / '+esc(i.size)+' × '+i.qty+'</td><td style="text-align:right;border-bottom:1px solid #E4DAC8">₹'+(i.price*i.qty).toLocaleString('en-IN')+'</td></tr>').join('')+
      '<tr><td style="padding:8px 0"><b>Total</b></td><td style="text-align:right"><b>₹'+o.total.toLocaleString('en-IN')+'</b></td></tr></table>'+
      '<p style="font-size:13px;color:#7C7166">Delivering to: '+esc(o.address.line1)+', '+esc(o.address.city)+' '+esc(o.address.pin)+'</p>'+
      '<p style="font-size:12px;color:#7C7166">Track anytime at /track-order with your order number.</p></div>' }),
    statusUpdate: v => ({ subject:'THE VERVE — Order '+v.no+' is now '+v.status, html:
      '<div style="background:#F5F0E7;padding:28px;font-family:Georgia,serif;color:#24140F"><div style="letter-spacing:.35em;font-size:20px;text-align:center">THE VERVE</div>'+
      '<h2 style="font-weight:500;margin-top:20px">'+esc(v.status)+'</h2><p style="font-size:14px">Your order <b>'+v.no+'</b> has moved to <b>'+esc(v.status)+'</b>.</p>'+
      (v.awb?'<p style="font-size:14px">Tracking AWB: <b>'+esc(v.awb)+'</b></p>':'')+
      '<p style="font-size:12px;color:#7C7166">Questions? care@theverve.in</p></div>' }),
    welcome: v => ({ subject:'Welcome to THE VERVE', html:
      '<div style="background:#F5F0E7;padding:28px;font-family:Georgia,serif;color:#24140F"><div style="letter-spacing:.35em;font-size:20px;text-align:center">THE VERVE</div>'+
      '<h2 style="font-weight:500;margin-top:20px">Welcome'+(v.name?', '+esc(v.name):'')+'.</h2>'+
      '<p style="font-size:14px">You are on the list — first access to drops, early previews and stories from the atelier.</p><p style="font-size:13px;color:#651B2B;letter-spacing:.2em">DEFINE YOUR PRESENCE.</p></div>' }),
    refund: v => ({ subject:'THE VERVE — Refund initiated for '+v.no, html:
      '<div style="background:#F5F0E7;padding:28px;font-family:Georgia,serif;color:#24140F"><div style="letter-spacing:.35em;font-size:20px;text-align:center">THE VERVE</div>'+
      '<h2 style="font-weight:500;margin-top:20px">Refund initiated</h2><p style="font-size:14px">'+fmt(v.amount)+' for order <b>'+v.no+'</b> has been initiated to your original payment method (or UPI for COD). It reflects in 5–7 business days.</p></div>' })
  };
  const t = templates[kind]; if(!t) return;
  const mail = t(vars);
  DB.emails.unshift({ id:uid('em'), kind, to, ...mail, at:new Date().toISOString() });
  if (DB.emails.length>120) DB.emails.length=120;
  saveDB();
}

/* ---------- wishlist ---------- */
function wishKey(){ const u=currentUser(); return u?u.id:cartId(); }
function wishList(){ return DB.wishlists[wishKey()]||[]; }
function toggleWish(pid){
  const k=wishKey(); const l=DB.wishlists[k]||[];
  const i=l.indexOf(pid);
  if (i>-1) l.splice(i,1); else l.push(pid);
  DB.wishlists[k]=l; saveDB();
  return i===-1;
}
function recentlyViewed(){
  try{ return JSON.parse(localStorage.getItem(VERVE_CONFIG.recentKey)||'[]'); }catch(e){ return []; }
}
function pushRecent(slug){
  let r = recentlyViewed().filter(s=>s!==slug);
  r.unshift(slug);
  localStorage.setItem(VERVE_CONFIG.recentKey, JSON.stringify(r.slice(0,8)));
}

/* ---------- analytics (GA4 / Meta Pixel — loaded only if IDs configured) ---------- */
function initAnalytics(){
  const c = VERVE_CONFIG;
  if (c.gaId){
    const s=document.createElement('script'); s.async=true; s.src='https://www.googletagmanager.com/gtag/js?id='+encodeURIComponent(c.gaId);
    document.head.appendChild(s);
    window.dataLayer=window.dataLayer||[]; function gtag(){dataLayer.push(arguments);} window.gtag=gtag;
    gtag('js', new Date()); gtag('config', c.gaId);
  }
  if (c.pixelId){
    window.fbq = window.fbq || function(){ (window.fbq.queue=window.fbq.queue||[]).push(arguments); };
    const s=document.createElement('script'); s.async=true; s.src='https://connect.facebook.net/en_US/fbevents.js';
    s.onload=()=>{ window.fbq('init', c.pixelId); window.fbq('track','PageView'); };
    document.head.appendChild(s);
  }
}
function trackEvent(name, data){ if (window.gtag) window.gtag('event', name, data||{}); if (window.fbq) window.fbq('trackCustom', name, data||{}); }

/* ---------- router ---------- */
const ROUTES = [
  { re:/^\/$/, page:'home' },
  { re:/^\/shop$/, page:'shop' },
  { re:/^\/collections$/, page:'collections' },
  { re:/^\/collections\/([\w-]+)$/, page:'collection' },
  { re:/^\/product\/([\w-]+)$/, page:'product' },
  { re:/^\/cart$/, page:'cart' },
  { re:/^\/checkout$/, page:'checkout' },
  { re:/^\/order-confirmation\/([\w-]+)$/, page:'orderConfirmation' },
  { re:/^\/invoice\/([\w-]+)$/, page:'invoice' },
  { re:/^\/account(?:\/([\w-]+))?$/, page:'account' },
  { re:/^\/track-order$/, page:'trackOrder' },
  { re:/^\/about$/, page:'staticPage' }, { re:/^\/contact$/, page:'staticPage' },
  { re:/^\/faq$/, page:'staticPage' }, { re:/^\/shipping-policy$/, page:'staticPage' },
  { re:/^\/returns$/, page:'staticPage' }, { re:/^\/privacy$/, page:'staticPage' },
  { re:/^\/terms$/, page:'staticPage' },
  { re:/^\/wishlist$/, page:'wishlist' },
  { re:/^\/admin(?:\/([\w-]+))?$/, page:'admin', admin:true }
];
let CURRENT_ROUTE = null;
function parseHash(){
  let h = location.hash.replace(/^#/,'') || '/';
  const qIdx = h.indexOf('?');
  let query = {};
  if (qIdx>-1){ const qs = new URLSearchParams(h.slice(qIdx+1)); qs.forEach((v,k)=>query[k]=v); h = h.slice(0,qIdx); }
  if (!h.startsWith('/')) h = '/'+h;
  for (const r of ROUTES){ const m = h.match(r.re); if (m) return { route:r, params:m.slice(1).filter(x=>x!==undefined), path:h, query }; }
  return { route:{ page:'404' }, params:[], path:h, query };
}
function go(path){ if (('#'+path)===location.hash) render(); else location.hash = path; }

let renderSeq = 0;
async function render(){
  const seq = ++renderSeq;
  const parsed = parseHash();
  CURRENT_ROUTE = parsed;
  const app = document.getElementById('app');
  const isHome = parsed.route.page==='home';
  const isAdminRoute = !!parsed.route.admin;
  window.scrollTo(0,0);
  let html = '';
  try{
    if (isAdminRoute) html = await renderAdmin(parsed);
    else html = await PAGES[parsed.route.page](parsed);
  }catch(err){
    console.error(err);
    html = chromeShell('<div class="container center" style="padding:6rem 0"><h1 style="font-size:3rem">Something went wrong.</h1><p class="muted" style="margin:1rem 0 2rem">'+esc(err.message)+'</p><a class="btn btn-solid" href="#/">BACK HOME</a></div>');
  }
  if (seq!==renderSeq) return; // a newer navigation superseded this render
  app.innerHTML = html;
  app.className = 'page';
  buildHeader(isAdminRoute);
  buildFooter(isAdminRoute, parsed);
  applyReveal();
  bindPage(parsed);
  updateSEO(parsed);
  refreshBagCount();
}
function applyReveal(){
  const io = new IntersectionObserver(es=>es.forEach(e=>{ if(e.isIntersecting){ e.target.classList.add('on'); io.unobserve(e.target); } }),{ threshold:.12 });
  document.querySelectorAll('.rv:not(.on)').forEach(el=>io.observe(el));
}
function updateSEO(parsed){
  let title = 'THE VERVE — Define Your Presence. | Premium Fashion & Streetwear India';
  let desc = 'Premium contemporary fashion and streetwear from India. Oversized tees, heavyweight essentials, limited editions.';
  let jsonld = null;
  if (parsed.route.page==='product'){
    const p = DB.products.find(x=>x.slug===parsed.params[0]);
    if (p){ title = p.name+' — THE VERVE'; desc = p.description.slice(0,150);
      jsonld = { '@context':'https://schema.org','@type':'Product', name:p.name, sku:p.sku, description:p.description,
        brand:{'@type':'Brand',name:'THE VERVE'}, offers:{'@type':'Offer',priceCurrency:'INR',price:p.price,availability: totalStock(p)>0?'https://schema.org/InStock':'https://schema.org/OutOfStock'} };
    }
  } else if (parsed.route.page==='shop'){ title='Shop All — THE VERVE'; }
  document.title = title;
  const md = document.querySelector('meta[name="description"]'); if (md) md.setAttribute('content', desc);
  const ld = document.getElementById('ld-json');
  if (ld) ld.textContent = jsonld ? JSON.stringify(jsonld) : JSON.stringify({'@context':'https://schema.org','@type':'Organization',name:'THE VERVE',slogan:'Define Your Presence.'});
}
function totalStock(p){ return p.sizes.reduce((s,size)=>s + p.colors.reduce((s2,c)=>s2+stockOf(p.id,c.name,size),0),0); }

/* ---------- global header ---------- */
function buildHeader(isAdminRoute){
  const h = document.getElementById('site-header');
  if (!h) return;
  const u = currentUser();
  const cnt = cartCount();
  h.innerHTML =
  '<div class="h-in">'+
    '<nav class="h-nav" aria-label="Primary">'+
      '<a href="#/shop" class="'+(CURRENT_ROUTE.route.page==='shop'?'active':'')+'">Shop</a>'+
      '<a href="#/collections/new-arrivals" class="'+(CURRENT_ROUTE.path==='/collections/new-arrivals'?'active':'')+'">New Arrivals</a>'+
      '<a href="#/collections" class="'+(CURRENT_ROUTE.route.page==='collections'?'active':'')+'">Collections</a>'+
      '<a href="#/collections/best-sellers">Best Sellers</a>'+
      '<a href="#/about" class="'+(CURRENT_ROUTE.route.page==='staticPage'&&CURRENT_ROUTE.path==='/about'?'active':'')+'">About</a>'+
    '</nav>'+
    '<a class="wordmark" href="#/" aria-label="THE VERVE home">'+
      '<img class="wm-img wm-dark" src="'+LOGO.dark+'" alt="" draggable="false">'+
      '<img class="wm-img wm-ivory" src="'+LOGO.ivory+'" alt="THE VERVE logo" draggable="false">'+
      '<small>DEFINE YOUR PRESENCE.</small></a>'+
    '<div class="h-acts">'+
      '<button data-action="search-open" aria-label="Search">'+svgIc('search')+'<span class="h-label">Search</span></button>'+
      '<a href="'+(u && u.role==='admin' ? '#/admin' : '#/account')+'" aria-label="Account">'+svgIc('user')+'<span class="h-label">'+(u? (u.role==='admin' ? 'Admin' : esc(u.name.split(' ')[0])) : 'Account')+'</span></a>'+
      '<a href="#/wishlist" aria-label="Wishlist" style="position:relative">'+svgIc('heart')+'</a>'+
      '<button data-action="cart-open" aria-label="Shopping bag" style="position:relative">'+svgIc('bag')+(cnt? '<span class="bag-count" id="bag-n">'+cnt+'</span>':'')+'</button>'+
      '<button class="burger" data-action="mnav-open" aria-label="Menu"><span></span><span></span><span></span></button>'+
    '</div>'+
  '</div>';
}
function refreshBagCount(){
  const el = document.getElementById('bag-n');
  const n = cartCount();
  if (el){ if(n) el.textContent=n; else el.remove(); }
  else {
    const btn = document.querySelector('[data-action="cart-open"]');
    if (btn && n) btn.insertAdjacentHTML('beforeend','<span class="bag-count">'+n+'</span>');
  }
}

/* ---------- footer ---------- */
function buildFooter(isAdminRoute, parsed){
  const f = document.getElementById('site-footer');
  if (!f) return;
  if (isAdminRoute || parsed.route.page==='checkout'){ f.style.display='none'; return; }
  f.style.display='';
  f.innerHTML =
  '<div class="container">'+
    '<div class="f-grid">'+
      '<div class="f-brand"><a class="wm" href="#/"><img class="wm-img" src="'+LOGO.ivory+'" alt="THE VERVE logo" draggable="false"></a><div class="tag">DEFINE YOUR PRESENCE.</div>'+
        '<p>Premium contemporary fashion and streetwear, designed in India for the world. Weight, drape and intent — in every piece.</p>'+
        '<div class="f-soc">'+
          '<a href="'+esc(DB.settings.social.instagram)+'" target="_blank" rel="noopener" aria-label="Instagram">'+svgIc('insta')+'</a>'+
          '<a href="'+esc(DB.settings.social.facebook)+'" target="_blank" rel="noopener" aria-label="Facebook">'+svgIc('fb')+'</a>'+
          '<a href="'+esc(DB.settings.social.x)+'" target="_blank" rel="noopener" aria-label="X">'+svgIc('xx')+'</a>'+
          '<a href="'+esc(DB.settings.social.youtube)+'" target="_blank" rel="noopener" aria-label="YouTube">'+svgIc('yt')+'</a>'+
        '</div></div>'+
      '<div><h4>Shop</h4>'+
        '<a href="#/shop">All Products</a><a href="#/collections/new-arrivals">New Arrivals</a><a href="#/collections/best-sellers">Best Sellers</a><a href="#/collections/limited-edition">Limited Edition</a><a href="#/shop?cat=essentials">Essentials</a></div>'+
      '<div><h4>Company</h4>'+
        '<a href="#/about">Our Story</a><a href="#/contact">Contact</a><a href="#/faq">FAQs</a><a href="#/track-order">Track Order</a><a href="#/admin" style="opacity:.55">Admin Console</a></div>'+
      '<div><h4>Support</h4>'+
        '<a href="#/shipping-policy">Shipping Policy</a><a href="#/returns">Returns &amp; Exchanges</a><a href="#/privacy">Privacy Policy</a><a href="#/terms">Terms &amp; Conditions</a>'+
        '<div style="margin-top:1rem;font-size:12px;color:var(--on-dark-muted)"><a href="mailto:'+VERVE_CONFIG.contact.email+'" style="color:inherit;text-decoration:underline;text-underline-offset:2px">'+esc(VERVE_CONFIG.contact.email)+'</a><br>'+esc(VERVE_CONFIG.contact.hours)+'</div></div>'+
    '</div>'+
    '<div class="f-bot"><div>© '+new Date().getFullYear()+' THE VERVE · ALL RIGHTS RESERVED</div>'+
      '<div class="f-pay"><span>UPI</span><span>VISA</span><span>MASTERCARD</span><span>RUPAY</span><span>NET BANKING</span><span>WALLETS</span><span>COD</span><span style="border-color:var(--gold);color:var(--gold)">SECURED BY RAZORPAY</span></div></div>'+
  '</div>';
}

/* ---------- page chrome shell (header/announcement/footer wrappers) ---------- */
function chromeShell(inner){
  const u = currentUser();
  return '<div id="site-header" class="header"></div>'+
    '<div class="announce" id="announce"></div>'+
    '<main id="main">'+inner+'</main>'+
    '<footer id="site-footer"></footer>';
}
function buildAnnouncement(){
  const a = document.getElementById('announce'); if(!a) return;
  const msgs = (DB.settings.announcements||[]).filter(x=>x.active).map(x=>esc(x.text));
  if (!msgs.length){ a.style.display='none'; return; }
  a.style.display='';
  let i = 0;
  const paint = () => { const el=a.querySelector('.a-msg'); if(!el) return; el.style.opacity='0'; setTimeout(()=>{ el.innerHTML = msgs[i%msgs.length] + (msgs.length>1?'<span class="a-dot">·</span>':''); el.style.opacity='1'; i++; },350); };
  a.innerHTML = '<span class="a-msg"></span>';
  paint();
  if (msgs.length>1) { clearInterval(window.__annT); window.__annT = setInterval(paint, 4200); }
}
</script>

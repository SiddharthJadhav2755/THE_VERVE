/* ---------- helpers used by seeding ---------- */
function invKey(pid,color,size){ return pid+'::'+color+'::'+size; }
function seedInventory(rng, products){
  const inv = {};
  products.forEach(p=>{
    p.colors.forEach((c,ci)=>{
      p.sizes.forEach((s,si)=>{
        let q = Math.floor(rng()*46)+8;              // 8–54 pcs
        if (p.tags.includes('limited')) q = Math.floor(rng()*5)+1;   // 1–5 pcs
        if (p.id==='p04' && ci===1 && si===5) q = 0;  // one sold-out variant for demo
        if (p.id==='p09' && si===0) q = 2;            // low-stock variant for demo
        inv[invKey(p.id, c.name, s)] = q;
      });
    });
  });
  return inv;
}
function daysAgo(n){ const d=new Date(Date.now()-n*86400000); return d.toISOString(); }

function seedOrders(rng, users){
  // Demo orders across ~6 months so analytics has real data to chart. Clearly demo data.
  const names = ['Aarav Mehta','Ishaan Kapoor','Vihaan Shah','Ananya Rao','Diya Malhotra','Kabir Singh','Aditi Verma','Rohan Iyer','Sara Khan','Arjun Nair','Meera Joshi','Dev Patel'];
  const cities = [['Mumbai','Maharashtra','400001'],['New Delhi','Delhi','110001'],['Bengaluru','Karnataka','560001'],['Pune','Maharashtra','411001'],['Hyderabad','Telangana','500001'],['Jaipur','Rajasthan','302001']];
  const pubs = SEED_PRODUCTS.filter(p=>p.published);
  const orders = [];
  const count = 16;
  for (let i=0;i<count;i++){
    const p = pubs[Math.floor(rng()*pubs.length)];
    const c = p.colors[Math.floor(rng()*p.colors.length)];
    const s = p.sizes[Math.floor(rng()*p.sizes.length)];
    const qty = 1 + Math.floor(rng()*2);
    const d = Math.floor(rng()*170)+1;
    const [city,state,pin] = cities[Math.floor(rng()*cities.length)];
    const person = users.length ? names[Math.floor(rng()*names.length)] : names[i%names.length];
    const method = rng() < .72 ? 'razorpay' : 'cod';
    const subtotal = p.price*qty;
    const ship = subtotal >= DEFAULT_SETTINGS.shipping.freeAbove ? 0 : DEFAULT_SETTINGS.shipping.flat;
    const cod = method==='cod' ? DEFAULT_SETTINGS.shipping.codFee : 0;
    const total = subtotal + ship + cod;
    let status;
    if (d > 21) status = 'Delivered';
    else if (d > 10) status = rng()<.5 ? 'Delivered' : 'Shipped';
    else if (d > 4) status = rng()<.5 ? 'Shipped' : 'Out for Delivery';
    else status = rng()<.5 ? 'Packed' : 'Processing';
    const seq = String(101 + i);
    orders.push({
      no:'TV-260'+seq, invoice:'INV-260'+seq, demo:true,
      userId: rng()<.35 && users[1] ? users[1].id : null, // demo orders belong to the demo customer — the admin account stays clean
      name: person, email: person.toLowerCase().replace(/ /g,'.')+'@example.com',
      phone:'9'+Math.floor(100000000 + rng()*899999999),
      address:{ line1:(10+Math.floor(rng()*300))+' '+['Linking Road','MG Road','Park Street','Banjara Hills','Sector 12','C-Scheme'][Math.floor(rng()*6)], area:city, city, state, pin, country:'India' },
      items:[{ pid:p.id, slug:p.slug, name:p.name, color:c.name, size:s, qty, price:p.price }],
      subtotal, discount:0, coupon:null, shipping:ship, codFee:cod, total,
      payment:{ method, status: method==='razorpay' ? 'Paid' : 'COD Pending', id: method==='razorpay' ? 'pay_DEMO'+Math.floor(rng()*1e9).toString(36).toUpperCase() : '', paidAt: method==='razorpay' ? daysAgo(d) : null, verified:true },
      status, awb: ['Shipped','Out for Delivery','Delivered'].includes(status) ? 'SR'+Math.floor(100000000+rng()*899999999) : '',
      timeline: buildTimeline(status, d),
      createdAt: daysAgo(d), updatedAt: daysAgo(d)
    });
  }
  return orders.sort((a,b)=> new Date(b.createdAt)-new Date(a.createdAt));
}
function buildTimeline(final, daysAgoN){
  const flow = ['Order Placed','Payment Confirmed','Processing','Packed','Shipped','Out for Delivery','Delivered'];
  let idx = flow.indexOf(final);
  if (['Cancelled','Returned','Refunded'].includes(final)) idx = 3;
  const tl = [];
  for (let k=0;k<=idx;k++){
    tl.push({ status: k===0 ? 'Order Placed' : (final==='COD Pending' && k===1 ? 'Order Placed' : flow[k]), at: daysAgo(Math.max(0, daysAgoN - (idx-k))) });
  }
  return tl;
}

async function seedDB(){
  const rng = mulberry32(20261113);
  const adminHash = await sha256('Verve@Admin2026');
  const demoHash = await sha256('Verve@Demo1');
  const users = [
    { id:'u-admin', name:'Store Admin', email:'admin@theverve.in', passHash:adminHash, phone:'', role:'admin', verified:true, addresses:[], createdAt:daysAgo(300) },
    { id:'u-demo', name:'Demo Customer', email:'demo@theverve.in', passHash:demoHash, phone:'9876543210', role:'customer', verified:true,
      addresses:[{ id:'adr1', label:'Home', line1:'14 Carter Road', area:'Bandra West', city:'Mumbai', state:'Maharashtra', pin:'400050', country:'India' }], createdAt:daysAgo(120) }
  ];
  const db = {
    meta:{ version:'1.0.0', seedVer:3, heroVer:2, authVer:2, dataVer:2, seededAt:new Date().toISOString(), demo:true },
    settings: JSON.parse(JSON.stringify(DEFAULT_SETTINGS)),
    categories: SEED_CATEGORIES,
    products: JSON.parse(JSON.stringify(SEED_PRODUCTS)),
    inventory: seedInventory(rng, SEED_PRODUCTS),
    users, sessions:{},
    carts:{}, orders: seedOrders(rng, users),
    coupons: JSON.parse(JSON.stringify(SEED_COUPONS)),
    reviews:[], returns:[], wishlists:{}, subscribers:[
      { email:'style.fan@example.com', at:daysAgo(40) }, { email:'streetwear.daily@example.com', at:daysAgo(22) }
    ],
    messages:[ { id:'m1', name:'Priya Nair', email:'priya@example.com', subject:'Size availability', message:'Will the Vantage restock in Chocolate XL? Loved it at the pop-up.', at:daysAgo(6), handled:false } ],
    emails:[]
  };
  return db;
}

/* ---------- persistence ---------- */
let DB = null;
function saveDB(){ try{ localStorage.setItem(VERVE_CONFIG.dbKey, JSON.stringify(DB)); }catch(e){ console.warn('save failed', e); if (typeof toast==='function') toast('Browser storage is full — remove a few product photos and save again', true); } }
async function loadDB(){
  const raw = localStorage.getItem(VERVE_CONFIG.dbKey);
  if (raw){
    try{
      DB = JSON.parse(raw);
      if (DB && DB.meta && DB.meta.version){
        if (DB.meta.seedVer !== 3){
          /* v2 build — wipe everything and start fresh: stale carts/orders/uploads from older copies are discarded */
          DB = await seedDB();
          saveDB();
          return DB;
        }
        await migrateDB(DB);
        return DB;
      }
    }catch(e){ /* corrupted -> reseed */ }
  }
  DB = await seedDB();
  saveDB();
  return DB;
}
function resetDemoData(){
  localStorage.removeItem(VERVE_CONFIG.dbKey); localStorage.removeItem(VERVE_CONFIG.tokenKey); localStorage.removeItem(VERVE_CONFIG.recentKey);
  Object.keys(localStorage).filter(k=>k.indexOf('verve_rl_')===0).forEach(k=>localStorage.removeItem(k)); // clear login rate-limit counters too
  location.hash = '#/'; location.reload();
}
async function migrateDB(db){
  /* data migrations for browsers with an older seeded copy */
  try{
    if (!db.meta) db.meta = {};
    if (db.meta.heroVer !== 2){
      db.settings.hero.image = IMG.hero; // v1.2 — floating-tee campaign hero
      db.meta.heroVer = 2;
      saveDB();
    }
    if (db.meta.authVer !== 2){
      /* v1.3 — exactly ONE admin login: canonical credentials, stale sessions & old accounts wiped */
      db.users = (db.users||[]).filter(u=>u.role!=='admin');
      db.users.push({ id:'u-admin', name:'Store Admin', email:'admin@theverve.in', passHash: await sha256('Verve@Admin2026'), phone:'', role:'admin', verified:true, addresses:[], createdAt:(db.meta&&db.meta.seededAt)||new Date().toISOString() });
      db.sessions = {};
      try{ localStorage.removeItem(VERVE_CONFIG.tokenKey); }catch(e){}
      db.meta.authVer = 2;
      saveDB();
    }
    if (db.meta.dataVer !== 2){
      /* v1.4 — the admin is not a customer: move its demo orders to the demo customer account */
      let moved = 0;
      (db.orders||[]).forEach(o=>{ if(o.userId==='u-admin'){ o.userId='u-demo'; moved++; } });
      db.meta.dataVer = 2;
      if (moved) saveDB();
    }
  }catch(e){}
}
</script>

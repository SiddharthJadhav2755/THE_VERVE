<script>
/* ============================================================
   PRODUCT DETAIL / WISHLIST / STATIC / TRACK ORDER
   ============================================================ */
let PDP = { pid:null, color:null, size:null, img:0 };

PAGES.product = async function(parsed){
  const p = DB.products.find(x=>x.slug===parsed.params[0]);
  if (!p || !p.published) return PAGES['404']();
  PDP = { pid:p.id, color:p.colors[0].name, size:null, img:0 };
  pushRecent(p.slug);
  const off = p.mrp>p.price ? Math.round((1-p.price/p.mrp)*100) : 0;
  const approved = DB.reviews.filter(r=>r.pid===p.id && r.status==='approved');
  const related = DB.products.filter(x=>x.published && x.id!==p.id && (x.category===p.category || x.tags.includes('bestseller'))).slice(0,4);
  const recent = recentlyViewed().filter(s=>s!==p.slug).map(s=>DB.products.find(x=>x.slug===s)).filter(Boolean).slice(0,4);
  const stock = totalStock(p);

  const thumbs = p.images.map((u,i)=>'<button data-action="pd-thumb" data-i="'+i+'" class="'+(i===0?'on':'')+'" aria-label="View image '+(i+1)+'">'+imgTag(u,p.name+' view '+(i+1))+'</button>').join('');

  return chromeShell(
  '<section style="padding:1.2rem 0 4rem"><div class="container-w pdp">'+
    '<div class="pdp-gallery">'+
      '<div class="pdp-thumbs">'+thumbs+'</div>'+
      '<div class="pdp-main" id="pdp-main" data-action="pd-zoom-toggle">'+imgTag(p.images[0],p.name,'main')+'<div class="zoom-hint">'+svgIc('zoom')+' HOVER / TAP TO ZOOM</div></div>'+
    '</div>'+
    '<div class="pdp-info">'+
      '<div class="crumbs"><a href="#/">HOME</a> &nbsp;/&nbsp; <a href="#/shop">SHOP</a> &nbsp;/&nbsp; <a href="#/collections/'+p.category+'">'+esc(catName(p.category).toUpperCase())+'</a></div>'+
      '<h1>'+esc(p.name)+'</h1>'+
      '<div class="sku">SKU '+esc(p.sku)+' · '+esc(p.fit)+' FIT · '+p.gsm+' GSM</div>'+
      '<div class="price-lg"><span class="now mono-nums">'+fmt(p.price)+'</span>'+(p.mrp>p.price?'<span class="mrp mono-nums">'+fmt(p.mrp)+'</span><span class="off">'+off+'% OFF</span>':'')+'</div>'+
      '<div class="tax-note">Inclusive of all taxes · Free shipping above '+fmt(DB.settings.shipping.freeAbove)+'</div>'+
      (p.demo? '<div class="notice" style="margin-top:1rem">Demo product — sample data from the seeded catalogue, replaced when real products are uploaded via Admin.</div>':'')+

      '<div class="opt-block"><div class="lbl"><h4>Colour — <span id="pd-color-name">'+esc(p.colors[0].name)+'</span></h4></div>'+
        '<div class="swatches">'+p.colors.map((c,i)=>'<button class="swatch'+(i===0?' on':'')+'" data-action="pd-color" data-i="'+i+'"><i style="background:'+esc(c.hex)+'"></i>'+esc(c.name)+'</button>').join('')+'</div></div>'+

      '<div class="opt-block"><div class="lbl"><h4>Size</h4><button class="mini-link" data-action="size-guide" data-pid="'+p.id+'">SIZE GUIDE</button></div>'+
        '<div class="sizes" id="pd-sizes">'+pdSizesHtml(p)+'</div>'+
        '<div class="stock-note" id="pd-stock"></div></div>'+

      '<div class="opt-block"><div class="lbl"><h4>Quantity</h4></div><div class="qty"><button data-action="pd-qty" data-d="-1" aria-label="Decrease">−</button><span class="q" id="pd-qty">1</span><button data-action="pd-qty" data-d="1" aria-label="Increase">+</button></div></div>'+

      '<div class="buy-row"><button class="btn btn-solid" id="pd-add" data-action="pd-add">ADD TO BAG</button>'+
        '<button class="btn btn-ghost" data-action="pd-buy">BUY NOW</button></div>'+
      '<button class="link-u" data-action="wish-toggle" data-pid="'+p.id+'" id="pd-wish">'+(wishList().includes(p.id)?'♥ SAVED TO WISHLIST':'♡ ADD TO WISHLIST')+'</button>'+

      '<div class="pin-check"><form data-form="pin"><div class="r"><input name="pin" inputmode="numeric" maxlength="6" placeholder="ENTER DELIVERY PIN CODE" aria-label="Delivery PIN code"><button class="btn btn-line btn-sm" type="submit">CHECK</button></div></form><div class="res" id="pin-res">Delivery estimate & COD availability — indicative.</div></div>'+

      '<div class="acc open" data-acc><button class="acc-h" data-action="acc-toggle" type="button">Description '+svgIc('plus')+'</button><div class="acc-b"><div class="in"><p>'+esc(p.description)+'</p><table class="spec">'+
        '<tr><td>Category</td><td>'+esc(catName(p.category))+'</td></tr>'+
        '<tr><td>Fit</td><td>'+esc(p.fit)+'</td></tr>'+
        '<tr><td>Fabric</td><td>'+esc(p.material)+' · '+p.gsm+' GSM</td></tr>'+
        '<tr><td>Country of origin</td><td>Made in India</td></tr></table></div></div></div>'+
      '<div class="acc" data-acc><button class="acc-h" data-action="acc-toggle" type="button">Fabric &amp; Care '+svgIc('plus')+'</button><div class="acc-b"><div class="in"><ul>'+p.care.map(c=>'<li>'+esc(c)+'</li>').join('')+'</ul></div></div></div>'+
      '<div class="acc" data-acc><button class="acc-h" data-action="acc-toggle" type="button">Delivery &amp; Returns '+svgIc('plus')+'</button><div class="acc-b"><div class="in"><p>Dispatch in 1–2 business days. Metro delivery 2–4 days, rest of India 3–7 days. 7-day easy returns and size exchanges on unworn pieces with tags intact — see <a href="#/returns" style="border-bottom:1px solid var(--line-2)">Returns &amp; Exchanges</a>.</p></div></div></div>'+

      '<div class="opt-block" style="margin-top:2rem"><div class="lbl"><h4>Reviews</h4><span class="hint">'+approved.length+' review'+(approved.length===1?'':'s')+'</span></div>'+
        (approved.length? approved.map(r=>'<div class="rv-item"><div class="h"><span class="who">'+esc(r.name)+' · <span style="color:var(--muted)">'+esc(r.title)+'</span></span><span class="rv-stars">'+'★'.repeat(r.rating)+'☆'.repeat(5-r.rating)+'</span></div><p>'+esc(r.body)+'</p><span style="font-size:10px;color:var(--muted);letter-spacing:.14em;text-transform:uppercase">'+dFmt(r.createdAt)+'</span></div>').join('')
          : '<p style="font-size:13px;color:var(--muted);padding:.6rem 0">No reviews yet — be the first to review this piece.</p>')+
        '<button class="btn btn-line btn-sm" style="margin-top:.9rem" data-action="review-open">WRITE A REVIEW</button></div>'+
    '</div></div></section>'+

    '<section class="block" style="border-top:1px solid var(--line);padding-top:clamp(2.4rem,5vw,4rem)"><div class="container-w">'+
      '<div class="sec-head rv"><div><div class="eyebrow">COMPLETE THE LOOK</div><h2 style="margin-top:.5rem">You may also like</h2></div></div>'+
      '<div class="grid-p">'+related.map((r,i)=>productCard(r,{i})).join('')+'</div></div></section>'+

    (recent.length? '<section class="block" style="padding-top:0"><div class="container-w">'+
      '<div class="sec-head rv"><div><div class="eyebrow">YOUR SESSION</div><h2 style="margin-top:.5rem">Recently viewed</h2></div></div>'+
      '<div class="rv-rail rv">'+recent.map((r,i)=>productCard(r,{rail:true,i})).join('')+'</div></div></section>':'')+

    '<div class="sticky-buy" id="sticky-buy-bar"><div class="m"><div class="n">'+esc(p.name)+'</div><div class="p mono-nums" id="pd-sticky-sub">'+fmt(p.price)+' · SELECT SIZE</div></div>'+
      '<button class="btn btn-ghost" data-action="pd-scroll-sizes">SIZES</button><button class="btn btn-solid" data-action="pd-add">ADD TO BAG</button></div>');
};

function pdSizesHtml(p){
  return p.sizes.map(s=>{
    const q = stockOf(p.id, PDP.color, s);
    const on = PDP.size===s?' on':'';
    return '<button class="size-b'+on+'" data-action="pd-size" data-size="'+esc(s)+'" '+(q<=0?'disabled aria-disabled="true"':'')+'>'+esc(s)+(q<=0?'<span class="so"></span>':'')+'</button>';
  }).join('');
}
function pdRefresh(){
  const p = DB.products.find(x=>x.id===PDP.pid); if(!p) return;
  const sz = document.getElementById('pd-sizes'); if (sz) sz.innerHTML = pdSizesHtml(p);
  const st = document.getElementById('pd-stock');
  const avail = PDP.size? stockOf(p.id,PDP.color,PDP.size) : null;
  if (st){
    if (!PDP.size){ st.textContent='Select a size'; st.className='stock-note'; }
    else if (avail===0){ st.textContent='This size is sold out'; st.className='stock-note low'; }
    else if (avail<=3){ st.textContent='Hurry — only '+avail+' left in '+PDP.size; st.className='stock-note low'; }
    else { st.textContent='In stock — ships in 1–2 business days'; st.className='stock-note in'; }
  }
  const qEl = document.getElementById('pd-qty'); if (qEl) qEl.textContent = Math.max(1,Math.min(PDP.qty||1, avail||9));
  const addBtn = document.getElementById('pd-add');
  if (addBtn) addBtn.disabled = !!PDP.size && avail===0;
  const sub = document.getElementById('pd-sticky-sub');
  if (sub) sub.textContent = fmt(p.price)+' · '+(PDP.size? PDP.color+' / '+PDP.size : 'SELECT SIZE');
  const main = document.querySelector('#pdp-main img'); const thumbs = document.querySelectorAll('.pdp-thumbs button');
  if (main){ main.src = p.images[PDP.img]||p.images[0]; thumbs.forEach((t,i)=>t.classList.toggle('on', i===PDP.img)); }
}
function openSizeGuide(pid){
  const p = DB.products.find(x=>x.id===pid)||DB.products[0];
  const rows = [['XS',38,26,17],['S',40,27,17.5],['M',42,28,18],['L',44,29,19],['XL',46,30,20],['XXL',48,31,21]];
  const isCargo = p.sizes[0]==='28';
  openModal('<h3>Size Guide</h3><div class="sub">'+esc(p.name)+' · '+esc(p.fit)+' fit — garment measurements in inches.</div>'+
   (isCargo
    ? '<table class="size-table"><tr><th>Waist</th><th>To Fit</th><th>Hip</th><th>Inseam</th></tr>'+
      [['28',28,38,29],['30',30,40,29.5],['32',32,42,30],['34',34,44,30],['36',36,46,30]].map(r=>'<tr>'+r.map(c=>'<td>'+c+'</td>').join('')+'</tr>').join('')+'</table>'
    : '<table class="size-table"><tr><th>Size</th><th>Chest</th><th>Length</th><th>Shoulder</th></tr>'+
      rows.map(r=>'<tr>'+r.map(c=>'<td>'+c+'</td>').join('')+'</tr>').join('')+'</table>')+
   '<p style="font-size:12px;color:var(--muted);margin-top:.9rem">'+(p.fit==='Oversized'?'The oversized block is cut 4–6" bigger at the chest than the regular — true to size for the intended drape; size down for a closer fit.':'Measure a garment that fits you well and compare. When between sizes, size up.')+'</p>', true);
}
function openReviewForm(pid){
  const u = currentUser();
  if (!u){ openModal('<h3>Sign in to review</h3><div class="sub">Only verified accounts can write reviews.</div><button class="btn btn-solid btn-block" data-action="goto-account">SIGN IN / REGISTER</button>'); return; }
  openModal('<h3>Write a review</h3><div class="sub">Reviews are published after moderation.</div>'+
    '<form data-form="review" data-pid="'+pid+'">'+
    '<div class="field"><label>Rating</label><select name="rating" class="inp"><option value="5">★★★★★ — 5</option><option value="4">★★★★ — 4</option><option value="3">★★★ — 3</option><option value="2">★★ — 2</option><option value="1">★ — 1</option></select></div>'+
    '<div class="field"><label>Headline</label><input name="title" class="inp" required maxlength="60"></div>'+
    '<div class="field"><label>Your review</label><textarea name="body" rows="4" class="inp" required maxlength="600"></textarea></div>'+
    '<button class="btn btn-solid btn-block">SUBMIT REVIEW</button></form>');
}

/* ============================================================
   WISHLIST
   ============================================================ */
PAGES.wishlist = async function(){
  const ids = wishList();
  const items = ids.map(id=>DB.products.find(p=>p.id===id)).filter(Boolean);
  return chromeShell(
  '<section class="page-hero"><div class="container-w"><div class="crumbs"><a href="#/">HOME</a> &nbsp;/&nbsp; WISHLIST</div><h1>Wishlist</h1></div></section>'+
  '<section style="padding-bottom:4.5rem"><div class="container-w">'+
  (items.length? '<div class="grid-p">'+items.map((p,i)=>productCard(p,{i})).join('')+'</div>'
    : '<div class="empty"><h3 class="serif">Nothing saved yet.</h3><p>Tap the heart on any piece to keep it here for later.</p><a class="btn btn-solid btn-sm" href="#/shop">EXPLORE THE COLLECTION</a></div>')+
  '</div></section>');
};

/* ============================================================
   STATIC PAGES (about / contact / faq / policies)
   ============================================================ */
PAGES.staticPage = async function(parsed){
  const slug = parsed.path.replace('/','');
  const overrides = DB.settings.pages[slug];
  const base = DEFAULT_PAGES[slug] || { title:slug.replace(/-/g,' '), html:'<p>Content coming soon.</p>' };
  const title = overrides? overrides.title : base.title;
  const html = overrides? overrides.html : base.html;
  if (slug==='contact'){
    return chromeShell(
    '<section class="page-hero"><div class="container-w"><div class="crumbs"><a href="#/">HOME</a> &nbsp;/&nbsp; CONTACT</div><h1>Contact</h1></div></section>'+
    '<section style="padding-bottom:4.5rem"><div class="container-w" style="display:grid;grid-template-columns:1fr 1.3fr;gap:3rem" id="contact-grid">'+
      '<div><h3 class="serif" style="font-size:26px;margin-bottom:1rem">We reply within one working day.</h3>'+
      '<p style="color:var(--muted);font-size:14px">Orders, sizing, collaborations or press — write to us or use the form (it opens your mail app with everything filled in). For order queries, keep your order number handy.</p>'+
      '<div style="margin-top:1.6rem;border-top:1px solid var(--line);padding-top:1.2rem;font-size:14px"><b style="font-weight:500;letter-spacing:.14em">EMAIL</b><br><a href="mailto:'+VERVE_CONFIG.contact.email+'" style="color:var(--burgundy);text-decoration:underline;text-underline-offset:2px">'+esc(VERVE_CONFIG.contact.email)+'</a></div>'+
      '<div style="margin-top:1rem;border-top:1px solid var(--line);padding-top:1.2rem;font-size:14px"><b style="font-weight:500;letter-spacing:.14em">HOURS</b><br>'+esc(VERVE_CONFIG.contact.hours)+'</div>'+
      '<div style="margin-top:1rem;border-top:1px solid var(--line);padding-top:1.2rem;font-size:14px"><b style="font-weight:500;letter-spacing:.14em">SUPPORT</b><br><a href="#/track-order" class="mini-link">TRACK AN ORDER</a> &nbsp; <a href="#/faq" class="mini-link">READ FAQS</a></div></div>'+
      '<form class="panel" data-form="contact" novalidate>'+
      '<div class="frow"><div class="field"><label>Name</label><input name="name" class="inp" required><div class="err">Please enter your name</div></div>'+
      '<div class="field"><label>Email</label><input name="email" type="email" class="inp" required><div class="err">Enter a valid email</div></div></div>'+
      '<div class="field"><label>Subject</label><select name="subject" class="inp"><option>Order support</option><option>Sizing help</option><option>Returns &amp; exchanges</option><option>Collaborations</option><option>Other</option></select></div>'+
      '<div class="field"><label>Message</label><textarea name="message" rows="5" class="inp" required></textarea><div class="err">Please write a message</div></div>'+
      '<button class="btn btn-solid btn-block">SEND MESSAGE</button></form>'+
    '</div></section>'+
    '<style>@media(max-width:900px){#contact-grid{grid-template-columns:1fr!important}}</style>');
  }
  if (slug==='faq'){
    const items = DEFAULT_FAQ;
    return chromeShell(
    '<section class="page-hero"><div class="container-w"><div class="crumbs"><a href="#/">HOME</a> &nbsp;/&nbsp; FAQ</div><h1>Frequently asked</h1></div></section>'+
    '<section style="padding-bottom:4.5rem"><div class="container"><div style="max-width:820px;margin-inline:auto">'+
      items.map((f,i)=>'<div class="faq-item" data-faq><button type="button" data-action="faq-toggle"><span>'+esc(f[0])+'</span><span style="font-family:var(--sans);font-size:18px;color:var(--muted)">+</span></button><div class="a"><p>'+esc(f[1])+'</p></div></div>').join('')+
      '<div class="notice" style="margin-top:2rem">Still unsure? <a href="#/contact" style="border-bottom:1px solid var(--line-2)">Write to us</a> — we reply within one working day.</div>'+
    '</div></div></section>');
  }
  return chromeShell(
  '<section class="page-hero"><div class="container-w"><div class="crumbs"><a href="#/">HOME</a> &nbsp;/&nbsp; '+esc(String(title).toUpperCase())+'</div><h1>'+esc(title)+'</h1></div></section>'+
  '<section style="padding-bottom:4.5rem"><div class="container"><div class="prose">'+html+'</div></div></section>');
};

/* ============================================================
   TRACK ORDER
   ============================================================ */
const STATUS_FLOW = ['Order Placed','Payment Confirmed','Processing','Packed','Shipped','Out for Delivery','Delivered','Cancelled','Returned','Refunded'];
PAGES.trackOrder = async function(parsed){
  const no = parsed.query && parsed.query.no;
  let resultHtml = '';
  if (no){
    const o = DB.orders.find(x=>x.no.toLowerCase()===String(no).toLowerCase());
    if (o){
      const flow = ['Order Placed','Payment Confirmed','Processing','Packed','Shipped','Out for Delivery','Delivered'];
      const terminal = ['Cancelled','Returned','Refunded'].includes(o.status);
      const idx = terminal? flow.indexOf('Packed') : flow.indexOf(o.status);
      resultHtml = '<div class="order-card rv on"><div class="oc-h"><div><b style="font-weight:500">'+esc(o.no)+'</b> · placed '+dFmt(o.createdAt)+'</div><span class="pill '+(o.status==='Delivered'?'pl-green':terminal?'pl-red':'pl-gold')+'">'+esc(o.status)+'</span></div>'+
        '<div class="oc-b"><div class="timeline">'+flow.map((s,i)=>'<div class="tl-step'+(i<=idx&&!terminal?' done':'')+(i===idx&&!terminal?' cur':'')+'"><div class="dot"></div><span>'+s+'</span></div>').join('')+'</div>'+
        (terminal? '<div class="notice" style="border-color:var(--burgundy)">This order is <b>'+esc(o.status)+'</b>. '+(o.status==='Refunded'?'The refund has been processed.':'')+'</div>':'')+
        (o.awb? '<div style="margin-top:.8rem;font-size:13px">Courier AWB: <b style="font-weight:500">'+esc(o.awb)+'</b> <span style="color:var(--muted)">(Shiprocket demo)</span></div>':'')+
        '<div style="margin-top:1rem">'+o.items.map(i=>'<div style="display:flex;justify-content:space-between;font-size:13px;padding:.3rem 0;border-bottom:1px dashed var(--line)"><span>'+esc(i.name)+' — '+esc(i.color)+' / '+esc(i.size)+' × '+i.qty+'</span><span class="mono-nums">'+fmt(i.price*i.qty)+'</span></div>').join('')+'</div>'+
        '<div style="margin-top:1rem;display:flex;gap:1rem;flex-wrap:wrap"><a class="btn btn-line btn-sm" href="#/invoice/'+o.no+'">VIEW INVOICE</a>'+
        (!terminal && ['Order Placed','Payment Confirmed','Processing'].includes(o.status)? '<button class="btn btn-line btn-sm" data-action="req-cancel" data-no="'+o.no+'">REQUEST CANCELLATION</button>':'')+
        (o.status==='Delivered'? '<button class="btn btn-line btn-sm" data-action="req-return" data-no="'+o.no+'">REQUEST RETURN</button>':'')+'</div>'+
      '</div></div>';
    } else {
      resultHtml = '<div class="empty"><h3 class="serif">Order not found.</h3><p>Check the order number — it looks like TV-260101. The demo database resets when you reset demo data.</p></div>';
    }
  }
  return chromeShell(
  '<section class="page-hero"><div class="container-w"><div class="crumbs"><a href="#/">HOME</a> &nbsp;/&nbsp; TRACK ORDER</div><h1>Track your order</h1></div></section>'+
  '<section style="padding-bottom:4.5rem"><div class="container"><div style="max-width:860px;margin-inline:auto">'+
    '<form class="panel" data-form="track" style="display:flex;gap:.8rem;flex-wrap:wrap;align-items:flex-end"><div class="field" style="flex:1;margin:0"><label>Order number</label><input name="no" class="inp" placeholder="TV-260101" required value="'+esc(no||'')+'"></div><button class="btn btn-solid" type="submit">TRACK</button></form>'+
    '<div style="margin-top:2rem">'+resultHtml+'</div>'+
  '</div></div></section>');
};

PAGES['404'] = async function(){
  return chromeShell('<div class="container center" style="padding:7rem 0 8rem">'+
    '<div class="eyebrow">ERROR 404</div><h1 style="font-size:clamp(3rem,8vw,6rem);margin:.8rem 0">Lost the thread.</h1>'+
    '<p style="color:var(--muted);margin-bottom:2rem">The page you are looking for does not exist or was moved.</p>'+
    '<a class="btn btn-solid" href="#/">BACK TO HOME</a></div>');
};
</script>
